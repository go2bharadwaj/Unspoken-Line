rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Account settings: only whether progression notes are kept
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['remember_progression'])
        && request.resource.data.remember_progression is bool;
    }

    match /users/{uid}/sessions/{sessionId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['created_at', 'timer_duration_sec', 'scores', 'calm_anchor', 'aura_hex',
             'reading_text', 'progression_text', 'trend_text', 'evidence', 'primary_class', 'source'])
        && request.resource.data.keys().hasAll(['created_at', 'timer_duration_sec', 'scores'])
        && request.resource.data.timer_duration_sec in [5, 10, 15, 30, 60]
        && request.resource.data.created_at == request.time
        && request.resource.data.scores is map
        && request.resource.data.scores.keys().hasOnly(['stress', 'anxiety', 'mental_fatigue', 'calm_flow', 'radiant_joy'])
        && request.resource.data.scores.keys().hasAll(['stress', 'anxiety', 'mental_fatigue', 'calm_flow', 'radiant_joy'])
        && request.resource.data.scores.stress is number && request.resource.data.scores.stress >= 0 && request.resource.data.scores.stress <= 1
        && request.resource.data.scores.anxiety is number && request.resource.data.scores.anxiety >= 0 && request.resource.data.scores.anxiety <= 1
        && request.resource.data.scores.mental_fatigue is number && request.resource.data.scores.mental_fatigue >= 0 && request.resource.data.scores.mental_fatigue <= 1
        && request.resource.data.scores.calm_flow is number && request.resource.data.scores.calm_flow >= 0 && request.resource.data.scores.calm_flow <= 1
        && request.resource.data.scores.radiant_joy is number && request.resource.data.scores.radiant_joy >= 0 && request.resource.data.scores.radiant_joy <= 1
        && (!('calm_anchor' in request.resource.data) || request.resource.data.calm_anchor is bool)
        && (!('aura_hex' in request.resource.data) || (request.resource.data.aura_hex is string && request.resource.data.aura_hex.matches('^#[0-9A-Fa-f]{6}$')))
        // The reading as shown, so it can be reopened from history (photos are never stored)
        && (!('reading_text' in request.resource.data) || (request.resource.data.reading_text is string && request.resource.data.reading_text.size() <= 20000))
        && (!('progression_text' in request.resource.data) || (request.resource.data.progression_text is string && request.resource.data.progression_text.size() <= 20000))
        && (!('trend_text' in request.resource.data) || (request.resource.data.trend_text is string && request.resource.data.trend_text.size() <= 2000))
        && (!('evidence' in request.resource.data) || (request.resource.data.evidence is list && request.resource.data.evidence.size() <= 10))
        && (!('primary_class' in request.resource.data) || request.resource.data.primary_class in ['Stress', 'Anxiety', 'Mental Fatigue', 'Calm Flow', 'Radiant Joy'])
        && (!('source' in request.resource.data) || request.resource.data.source in ['gemini', 'fallback']);

      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['calm_anchor', 'aura_hex', 'summary', 'rating'])
        && (!('calm_anchor' in request.resource.data) || request.resource.data.calm_anchor is bool)
        && (!('aura_hex' in request.resource.data) || (request.resource.data.aura_hex is string && request.resource.data.aura_hex.matches('^#[0-9A-Fa-f]{6}$')))
        // Progression notes (S_n); same 1500-char cap as the backend
        && (!('summary' in request.resource.data) || (request.resource.data.summary is string && request.resource.data.summary.size() > 0 && request.resource.data.summary.size() <= 1500))
        // How accurate the person found the reading: 1-10, with no 7
        && (!('rating' in request.resource.data) || (request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 10 && request.resource.data.rating != 7));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
